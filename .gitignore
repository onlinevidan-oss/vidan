# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI
supabase/.temp/

# Service account түлхүүр — хэзээ ч git-д оруулж болохгүй
*-*.json
!package.json
!tsconfig.json
!pnpm-workspace.yaml
gcp-*.json
service-account*.json

# Ажлын түр гаралт (гэрээ, баримт) — репод хадгалахгүй
output/
outputs/

# Claude Code-ийн локал тохиргоо — машин дээрх бүх session хуваалцдаг,
# репод хадгалахгүй (dev-preview.mjs дамжуулагч ч энд байрлана)
.claude/

# Нийлүүлэгчийн лавлах материал (QPay-ийн Postman цуглуулга, GS1-ийн
# ангиллын хуудас) — репод хадгалахгүй. Хэмжээ томоос гадна QPay-ийн
# жишээ цуглуулгад тэдний демо нэвтрэх мэдээлэл агуулагддаг.
*.postman_collection*.json
*V2 API with Ebarimt*.xlsx
